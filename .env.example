# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# --- News APIs (optional, add the one you chose) ---
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# --- Database ---
# Local development uses SQLite. Later (Milestone 7/9) we switch to Postgres (Neon/Supabase).
DATABASE_URL=sqlite:///data/newsintel.sqlite

# --- Hugging Face (needed later to download/upload models) ---
HF_TOKEN=

# --- Backend ---
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO

# --- Collection ---
# Identify your bot politely: include a contact email so site owners can reach you.
USER_AGENT=BhashaPulseBot/0.1 (student research project; contact: your-email@example.com)
# Seconds to wait between requests to the same website.
REQUEST_DELAY_SECONDS=2
